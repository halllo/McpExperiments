<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASPIRE010: keep DCP and the dashboard restored from NuGet at the SDK's version, rather than from
         whichever Aspire CLI bundle is installed, so the build is reproducible from this file alone. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IdentityServer\IdentityServer.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\MyMCPServer.Sse\MyMCPServer.Sse.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\MyMCPClient.Web\MyMCPClient.Web.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="..\MyAgent\MyAgent.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Yarp" Version="13.6.4" />
  </ItemGroup>

</Project>
